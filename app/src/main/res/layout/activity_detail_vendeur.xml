<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <!-- Toolbar blanche, cohérente avec le header de la liste :
         plus de violet plein, juste une ligne fine en dessous -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarDetail"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/white"
        app:titleTextColor="#1C1C1E"
        app:navigationIconTint="#1C1C1E"
        app:toolbarNavigationButtonStyle="@style/MyToolbarNavigationButtonStyle"
        app:title="Détail du vendeur" />

    <!-- Ligne fine de séparation, même technique que sur MainActivity -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#E0E0E0" />

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:background="#FFFFFF"
        android:padding="24dp">

        <!-- Photo : fond violet pâle par défaut, cohérent avec les avatars
             de la liste, pas d'ombre marquée -->
        <androidx.cardview.widget.CardView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="32dp"
            app:cardCornerRadius="70dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#EEEDFE">

            <ImageView
                android:id="@+id/imgDetailPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/txtDetailNom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="20sp"
            android:textStyle="normal"
            android:textColor="#1C1C1E" />

        <TextView
            android:id="@+id/txtDetailDatenais"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="14sp"
            android:textColor="#8E8E93" />

        <!-- Espace flexible qui pousse les boutons vers le bas -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Boutons à bordure fine plutôt que fond plein, cohérent
             avec le style minimaliste (seul un accent limité reste coloré) -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModifier"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Modifier"
                android:textColor="#1C1C1E"
                android:textSize="14sp"
                app:icon="@android:drawable/ic_menu_edit"
                app:iconTint="#1C1C1E"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:cornerRadius="12dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp"
                android:backgroundTint="@android:color/white"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSupprimer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Supprimer"
                android:textColor="#D32F2F"
                android:textSize="14sp"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconTint="#D32F2F"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:cornerRadius="12dp"
                app:strokeColor="#D32F2F"
                app:strokeWidth="1dp"
                android:backgroundTint="@android:color/white"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>